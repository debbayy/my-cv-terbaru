# ---- App ----
# URL publik aplikasi (dipakai Chromium untuk membuka /print dan callback Midtrans)
APP_URL=http://localhost:3000
# String acak min 32 karakter: `openssl rand -hex 32`
PRINT_SECRET=

# ---- Supabase (Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# RAHASIA — hanya di server, jangan pernah diberi prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---- Midtrans (Dashboard → Settings → Access Keys) ----
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
